# ─── Base de datos ────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_secret_change_me
DB_USERNAME=citt_user
DB_PASSWORD=citt_pass_change_me

# Nombres de las bases de datos locales
DB_NAME_DESPACHOS=despachos_db
DB_NAME_VENTAS=ventas_db

# Para producción (AWS RDS) – reemplaza con el endpoint real de RDS
DB_ENDPOINT=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# ─── Tag de imagen (se sobreescribe automáticamente en GitHub Actions) ─────────
IMAGE_TAG=latest
